# GEMINI_API_KEY: Optional Gemini API Key (injected by AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MIDTRANS_SERVER_KEY: Midtrans Sandbox/Production Server Key (NEVER expose to frontend)
MIDTRANS_SERVER_KEY=""

# MIDTRANS_CLIENT_KEY: Midtrans Sandbox/Production Client Key (served via /api/config/public)
MIDTRANS_CLIENT_KEY=""

# MIDTRANS_IS_PRODUCTION: Set to "true" only in live production
MIDTRANS_IS_PRODUCTION="false"
